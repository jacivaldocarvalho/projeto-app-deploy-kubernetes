FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build

FROM php:8.4-apache-bookworm@sha256:57ccfbd765e5ee5f85dee5864e47ca8db0b540b0c091c052d9b275b2498a5395

WORKDIR /var/www/html
RUN docker-php-ext-install mysqli
COPY backend/php.ini /usr/local/etc/php/conf.d/application.ini

COPY backend/index.php backend/conexao.php backend/health.php ./
COPY --from=frontend-build /app/dist/index.html ./frontend.html
COPY --from=frontend-build /app/dist/assets/ ./assets/

EXPOSE 80
