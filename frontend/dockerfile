FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build

FROM nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
ENV PHP_UPSTREAM=php-backend:80
COPY frontend/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=frontend-build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
